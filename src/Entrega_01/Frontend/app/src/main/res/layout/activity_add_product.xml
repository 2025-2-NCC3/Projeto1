<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EBD9D9"
    tools:context=".activity.AddProductActivity">

    <!-- Botão Voltar -->
    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voltar"
        android:textColor="#FFFFFF"

        android:backgroundTint="#2D4739"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@android:drawable/btn_default" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/logo"
        android:contentDescription="Logo"
        app:layout_constraintTop_toBottomOf="@id/btnVoltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Card branco -->
    <LinearLayout
        android:id="@+id/cardProduto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="24dp"
        android:elevation="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:clipToOutline="true"
        android:translationZ="2dp"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título -->
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dados do produto"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- Botão Adicionar Foto -->
        <Button
            android:id="@+id/btnAdicionarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adicionar foto +"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2D4739"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- Campo Nome -->
        <EditText
            android:id="@+id/editNomeProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome*"
            android:inputType="text"
            android:backgroundTint="#2D4739" />

        <!-- Campo Preço -->
        <EditText
            android:id="@+id/editPrecoProduto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Preço (R$)*"
            android:inputType="numberDecimal"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2D4739" />

        <!-- Categoria -->
        <Spinner
            android:id="@+id/spnCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2D4739" />

        <!-- Quantidade -->
        <EditText
            android:id="@+id/edtQuantidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Quantidade disponível*"
            android:inputType="number"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2D4739" />

        <!-- Descrição -->
        <EditText
            android:id="@+id/edtDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descrição*"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2D4739" />
    </LinearLayout>

    <!-- Botão Concluir -->
    <Button
        android:id="@+id/btnConcluir"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Concluir"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2D4739"
        android:textSize="16sp"
        android:paddingVertical="12dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardProduto"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão Listar Produtos -->
    <Button
        android:id="@+id/btnListarProdutos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Listar produtos"
        android:textColor="#FFFFFF"
        android:backgroundTint="#406351"
        android:textSize="16sp"
        android:paddingVertical="12dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnConcluir"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>