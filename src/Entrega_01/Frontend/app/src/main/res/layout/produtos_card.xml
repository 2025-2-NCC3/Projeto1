<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180dp"
    android:layout_height="250dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_margin="2dp">

    <!-- Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="182dp"
        android:clipChildren="false"
        android:clickable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:clipToPadding="false"
        app:cardCornerRadius="38dp"
        app:cardElevation="11dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true">


    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="60dp"> <!-- Espaço para a imagem -->

            <!-- Nome do produto -->
            <TextView
                android:id="@+id/txtNomeProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Coxinha"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:translationY="19dp" />

            <!-- Preço -->
            <TextView
                android:id="@+id/txtPrecoProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="R$ 8,50"
                android:textColor="#00875A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:translationY="19dp" />

            <ImageView
                android:id="@+id/imgCarrinho"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:contentDescription="Adicionar ao carrinho"
                android:src="@drawable/carrinho"
                android:tint="#00875A"
                android:translationY="0dp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imgFavoritar"
            android:layout_width="23dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Favoritar"
            android:src="@drawable/favoritos"
            android:tint="#625757" />
    </androidx.cardview.widget.CardView>

    <!-- Imagem do produto sobre o Card -->
    <ImageView
        android:id="@+id/imgProduto"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="top|center_horizontal"
        android:translationY="-2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/coxinha"
        android:background="@drawable/circle_background"
        android:clipToOutline="true"
        android:elevation="15dp"/>

    <!-- Coração para favoritar -->

    <!-- Carrinho para adicionar ao carrinho -->
    <!-- Corrigido o valor de translationY -->

</FrameLayout>
