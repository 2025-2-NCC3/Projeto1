<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/perfil_fundo">

    <!-- Campo Nome -->
    <ImageView
        android:id="@+id/imgPerfil"
        android:layout_width="190dp"
        android:layout_height="152dp"
        android:src="@drawable/usuario"
        tools:layout_editor_absoluteX="116dp"
        tools:layout_editor_absoluteY="66dp" />

    <EditText
        android:id="@+id/inputNome"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="40dp"
        android:hint="Nome"
        android:background="@drawable/caixa_input"
        android:paddingStart="16dp"
        android:textColor="#000"
        android:textColorHint="#666"
        app:layout_constraintTop_toBottomOf="@id/imgPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo Email -->
    <EditText
        android:id="@+id/inputEmail"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="40dp"
        android:hint="E-mail"
        android:background="@drawable/caixa_input"
        android:paddingStart="16dp"
        android:inputType="textEmailAddress"
        android:textColor="#000"
        android:textColorHint="#666"
        app:layout_constraintTop_toBottomOf="@id/inputNome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo Senha -->
    <EditText
        android:id="@+id/inputSenha"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="40dp"
        android:hint="Senha"
        android:background="@drawable/caixa_input"
        android:paddingStart="16dp"
        android:inputType="textPassword"
        android:textColor="#000"
        android:textColorHint="#666"
        app:layout_constraintTop_toBottomOf="@id/inputEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão de salvar -->
    <Button
        android:id="@+id/btnSalvar"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginTop="30dp"
        android:backgroundTint="#304A3D"
        android:text="Salvar alterações"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/inputSenha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- MENU INFERIOR -->
    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#F2E2E2"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/home"
            android:tint="#7B7B7B" />

        <ImageView
            android:id="@+id/iconFavorite"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/favoritos"
            android:tint="#7B7B7B" />

        <ImageView
            android:id="@+id/iconCart"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/carrinho"
            android:tint="#7B7B7B" />

        <ImageView
            android:id="@+id/iconHistory"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/historico"
            android:tint="#7B7B7B" />

        <ImageView
            android:id="@+id/iconProfile"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/perfil"
            android:tint="#7B7B7B" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
