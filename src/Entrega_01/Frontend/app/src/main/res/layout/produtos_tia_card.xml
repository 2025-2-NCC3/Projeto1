<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="165dp"
    android:layout_height="170dp"
    android:layout_margin="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- CARD PRINCIPAL -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="28dp"
        app:cardElevation="6dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true"
        android:clickable="false"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="58dp"
            android:paddingBottom="12dp">

            <!-- Nome do produto -->
            <TextView
                android:id="@+id/txtNomeProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Coxinha"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:paddingTop="10dp" />

            <!-- Preço -->
            <TextView
                android:id="@+id/txtPrecoProduto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="R$ 8,50"
                android:textColor="#00875A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Ícones inferiores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgCarrinho"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="20dp"
                    android:contentDescription="Editar produto"
                    android:src="@drawable/editar"
                    android:tint="#00875A"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/imgLixeira"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Excluir produto"
                    android:src="@drawable/lixeira"
                    android:tint="#B00020"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Ícone de favorito -->
        <ImageView
            android:id="@+id/imgFavoritar"
            android:layout_width="23dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:tint="#625757"
            android:src="@drawable/favoritos" />

    </androidx.cardview.widget.CardView>

    <!-- IMAGEM DO PRODUTO (redonda e sobreposta acima do card) -->
    <ImageView
        android:id="@+id/imgProduto"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_gravity="top|center_horizontal"
        android:translationY="-10dp"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_background"
        android:clipToOutline="true"
        android:elevation="12dp"
        android:src="@drawable/coxinha"
        android:contentDescription="Imagem do produto" />

</FrameLayout>
