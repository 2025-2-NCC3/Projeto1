<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9DADA"
    android:padding="24dp">

    <!-- Título -->
    <TextView
        android:id="@+id/tituloPix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pagamento via Pix"
        android:textColor="#304A3D"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Valor total -->
    <TextView
        android:id="@+id/valorPix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 0,00"
        android:textColor="#1D8F58"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tituloPix"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Mensagem -->
    <TextView
        android:id="@+id/mensagemPix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Use o QR Code abaixo para pagar com Pix."
        android:textColor="#333333"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/valorPix"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- QR Code -->
    <ImageView
        android:id="@+id/qrCodeImage"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="24dp"
        android:contentDescription="QR Code Pix"
        app:layout_constraintTop_toBottomOf="@id/mensagemPix"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botão Voltar -->
    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="200dp"
        android:layout_height="55dp"
        android:text="Voltar ao menu"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#304A3D"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/qrCodeImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
