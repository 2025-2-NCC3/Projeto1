<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9DADA"

    tools:context=".activity.PedidosActivity">


    <!-- Onda por cima (PNG com transparência) -->
    <ImageView
        android:id="@+id/bgWaveBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/onda"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Logo -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="169dp"
        android:layout_height="163dp"
        android:layout_marginTop="50dp"
        android:contentDescription="Logo Comedoria"
        android:src="@drawable/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Abas -->
    <!-- Abas -->
    <LinearLayout
        android:id="@+id/abasLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/abaAnteriores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Anteriores"
            android:textColor="#3C3C3C"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Underline alinhado ao texto -->
        <View
            android:id="@+id/linhaAnteriores"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="6dp"
            android:background="#1B5E20"/>
    </LinearLayout>

    <!-- Linha da aba -->

    <View
        android:id="@+id/linhaPedidos"
        android:layout_width="80dp"
        android:layout_height="3dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/abasLayout"
        app:layout_constraintStart_toStartOf="@id/abaAnteriores"
        app:layout_constraintEnd_toEndOf="@id/abaAnteriores" />

    <!-- LISTA (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPedidos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/linhaPedidos"
        app:layout_constraintBottom_toTopOf="@id/bottomMenu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_pedido" />

    <!-- MENU INFERIOR -->
    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:background="#E9DADA"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iconHome"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/home"
            android:tint="#7B7B7B" />

        <ImageView
            android:id="@+id/iconFavorite"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/favoritos"
            android:tint="#7B7B7B" />

        <ImageView
            android:id="@+id/iconCart"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/carrinho"
            android:tint="#7B7B7B" />

        <ImageView
            android:id="@+id/iconHistory"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/historico"
            android:tint="#7B7B7B" />

        <ImageView
            android:id="@+id/iconProfile"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginHorizontal="16dp"
            android:src="@drawable/perfil"
            android:tint="#7B7B7B" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
