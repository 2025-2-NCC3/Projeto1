<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9DADA">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="129dp"
        android:layout_height="120dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/logo"
        android:contentDescription="Logo Comedoria"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tituloPedidos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Favoritos"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="#3C3C3C"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/barraPedidos"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:background="#1B5E20"
        app:layout_constraintTop_toBottomOf="@id/tituloPedidos"
        app:layout_constraintStart_toStartOf="@id/tituloPedidos"
        app:layout_constraintEnd_toEndOf="@id/tituloPedidos" />

    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/barraPedidos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="41dp"
            android:layout_height="48dp"
            android:src="@drawable/lupa"
            android:contentDescription="Buscar" />

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Pesquisar"
            android:inputType="text"
            android:textColor="#333333"
            android:textColorHint="#7B7B7B" />
    </LinearLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerFavoritos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchContainer"
        app:layout_constraintVertical_bias="1.0"
        tools:listitem="@layout/produtos_card" />

    <LinearLayout
        android:id="@+id/bottomMenu"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#E9DADA"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnHome"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/home"
            android:layout_marginHorizontal="16dp"
            app:tint="#7B7B7B"
            android:contentDescription="Home" />

        <ImageView
            android:id="@+id/btnFavoritos"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/favoritos"
            android:layout_marginHorizontal="16dp"
            app:tint="#7B7B7B"
            android:contentDescription="Favoritos" />

        <ImageView
            android:id="@+id/btnCarrinho"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/carrinho"
            android:layout_margin="16dp"
            app:tint="#7B7B7B"
            android:contentDescription="@string/app_name" />

        <ImageView
            android:id="@+id/btnHistorico"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/historico"
            android:layout_marginHorizontal="16dp"
            app:tint="#7B7B7B"
            android:contentDescription="Histórico" />

        <ImageView
            android:id="@+id/btnPerfil"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/perfil"
            android:layout_marginHorizontal="16dp"
            app:tint="#7B7B7B"
            android:contentDescription="Perfil" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
